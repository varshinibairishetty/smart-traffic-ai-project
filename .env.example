# ==============================================================================
# Smart Traffic AI System — Full-Stack Environment Template (.env.example)
# ==============================================================================

# ── Backend Configuration (backend/.env) ──────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
BROADCAST_INTERVAL_MS=5000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
LOG_LEVEL=INFO
LOG_FORMAT=pretty
DETECTION_OUTPUT_PATH=../ai-service/detection_output.json
AI_SERVICE_URL=http://localhost:8000

# ── Frontend Configuration (frontend/.env) ─────────────────────────────────────
# URL where backend REST API is hosted
VITE_API_BASE_URL=http://localhost:5000

# URL where Socket.io WebSocket server is hosted
VITE_SOCKET_URL=http://localhost:5000

# ── AI Service Configuration (ai-service/) ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
SOCKET_SERVER_URL=http://localhost:5000
