# ─── AI Model Weights ───────────────────────────────────────────
# These are large binary files — download them separately.
# Ultralytics downloads yolov8*.pt automatically on first run.
ai-service/models/*.pt
ai-service/models/*.onnx
ai-service/models/*.engine
*.pt
*.onnx
*.engine

# ─── Data Files ─────────────────────────────────────────────────
# Raw datasets and video files are not committed to Git.
data/raw/
data/processed/
*.mp4
*.avi
*.mov
*.mkv
*.csv

