# ==============================================================================
# Smart Traffic Management — Backend Environment Configuration (.env.example)
# Copy this file to .env before starting the server.
# ==============================================================================

# ── Server Configuration ──────────────────────────────────────────────────────
# Port for HTTP REST endpoints and Socket.io WebSocket server
PORT=5000

# Execution environment: 'development', 'production', or 'test'
# In 'production', Express serves static compiled assets from frontend/dist
NODE_ENV=development

# ── Cross-Origin Resource Sharing (CORS) & WebSockets ─────────────────────────
# Allowed origins for HTTP REST API and Socket.io clients.
# Multiple origins may be comma-separated: http://localhost:5173,http://127.0.0.1:5173
# Use * for wildcard access during local development or container demo
CORS_ORIGIN=http://localhost:5173

# Broadcast frequency (ms) for live traffic updates over Socket.io
BROADCAST_INTERVAL_MS=5000

# ── Security & Rate Limiting ──────────────────────────────────────────────────
# Rate limit window in milliseconds (default: 15 minutes = 900000 ms)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of API requests permitted per window per IP
RATE_LIMIT_MAX=500

# ── Structured Logging ────────────────────────────────────────────────────────
# Log verbosity level: 'DEBUG', 'INFO', 'WARN', 'ERROR'
LOG_LEVEL=INFO

# Log output format: 'pretty' (colored for terminal) or 'json' (structured for containers)
LOG_FORMAT=pretty

# ── Computer Vision Service Integration ───────────────────────────────────────
# File path to the detection results JSON generated by the Python YOLO service
DETECTION_OUTPUT_PATH=../ai-service/detection_output.json

# URL to the Python FastAPI computer vision service
AI_SERVICE_URL=http://localhost:8000
