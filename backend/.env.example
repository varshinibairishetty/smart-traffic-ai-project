# =====================================================================
# Smart Traffic Management & Accident Prediction System — Environment Configuration
# =====================================================================

# Server Port & CORS
PORT=5000
CORS_ORIGIN=http://localhost:5173

# External Traffic Provider (TomTom)
# Register for a free developer key (2,500 requests/day, no credit card required):
# https://developer.tomtom.com
TOMTOM_API_KEY=your_tomtom_api_key_here

# External Weather Provider (Optional)
# If left blank, the system automatically uses Open-Meteo (100% free, zero-key required):
OPENWEATHER_API_KEY=

# In-Memory Cache Time-To-Live (TTL in milliseconds)
# Recommended: Traffic = 5 mins (300,000 ms), Weather = 15 mins (900,000 ms)
TRAFFIC_CACHE_TTL_MS=300000
WEATHER_CACHE_TTL_MS=900000

# Legacy AI Vision Service (Optional secondary feature)
AI_SERVICE_URL=http://localhost:8000
DETECTION_OUTPUT_PATH=../ai-service/detection_output.json
